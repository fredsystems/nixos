      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (jail) (count_over_time({host=\"fredvps\", unit=\"fail2ban.service\"} |~ \"NOTICE.*Ban \" | regexp \"\\\\[(?P<jail>[^\\\\]]+)\\\\] Ban\" [1h]))",
          "legendFormat": "{{jail}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Blocked Probes (nginx 444)",
      "description": "Live feed of requests dropped by the probe rule -- the raw scanner traffic that feeds the nginx-probe jail.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
