    {
      "id": 12,
      "type": "row",
      "title": "Who Is Hitting Us",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Ban / Unban Events",
      "description": "fail2ban's own log. The authoritative record of which IP was banned, by which jail, and when.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{host=\"fredvps\", unit=\"fail2ban.service\"} |~ \"(Ban|Unban)\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Ban Events (per hour, by jail)",
      "description": "Derived from the fail2ban log rather than the exporter, so it survives an exporter restart.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
